# ═══════════════════════════════════════════
# MESH-TECH-V2 Environment Configuration
# ═══════════════════════════════════════════

# Required: Your WhatsApp session ID (starts with Mesh~)
# Get it from your session generator: https://github.com/mesh057/MESH-TECH-SESSION
SESSION_ID=Mesh~your_session_id_here

# Bot Mode: public | private | self
MODE=public

# Owner number (with country code, no + or spaces)
OWNER_NUMBER=254746844168

# Timezone
TIME_ZONE=Africa/Nairobi

# Auto Features
AUTO_READ_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_REPLY_STATUS=false

# Database: leave blank for SQLite, or use PostgreSQL URL
DATABASE_URL=

# Optional: API Keys for extended features
OPENAI_API_KEY=
GEMINI_API_KEY=

# Bot Metadata
BOT_NAME=MESH-TECH-V2
PREFIX=!.
